# Cloudflare: `npx wrangler whoami` shows the account ID.
# Token: Dashboard > My Profile > API Tokens > Custom token with Edit on
# Workers AI, Vectorize, D1, Workers R2 Storage, Workers KV Storage.
CF_ACCOUNT_ID=eb04c3d140ad3ec7669f5dbbde518cf7
CF_PIPELINE_TOKEN=

# AI Gateway auth token (AI Gateway: Run only). Sent as cf-aig-authorization header.
CF_AIG_TOKEN=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Resource names and IDs (already created)
D1_DATABASE_ID=9f0976b2-73c7-4d4a-b0b5-72caa6186e14
VECTORIZE_INDEX=flamesense-papers
R2_BUCKET=flamesense-assets
KV_NAMESPACE_ID=4a31e4cde53b4a2ab4bbd79cc9818ecd

# Gateway endpoint for OpenRouter calls
AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/eb04c3d140ad3ec7669f5dbbde518cf7/default/openrouter
